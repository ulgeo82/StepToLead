POSTGRES_DB=outreach
POSTGRES_USER=outreach
POSTGRES_PASSWORD=outreach
DATABASE_URL=postgresql+asyncpg://outreach:outreach@postgres:5432/outreach
REDIS_URL=redis://redis:6379/0
NEXT_PUBLIC_API_URL=http://localhost:8000
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
ENCRYPTION_SECRET=change-this-before-production
ACCOUNT_STATUS_INTERVAL=20
# Бот для уведомлений о лидах и продажах (токен от @BotFather)
TELEGRAM_BOT_TOKEN=

# ИИ-помощник в чатах: yandex | openai | anthropic | openai_compatible (пусто — выключен)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# Модель на функцию; пусто — использовать LLM_MODEL.
LLM_MODEL_CHAT=
LLM_MODEL_SUMMARY=
LLM_MODEL_CALLS=
LLM_MODEL_CAMPAIGNS=
# Таймаут одной попытки, секунды; при 429/5xx/таймауте повтор один раз через 1 с.
LLM_TIMEOUT=60
# Экспресс-оценка /brief: рабочая компания агентства, срок демо и ссылки.
# 0 отключает публичную отправку. Укажите собственную опубликованную политику.
AGENCY_WORKSPACE_ID=0
BRIEF_DEMO_TTL_DAYS=14
# Общий лимит автоматически созданных демо за сутки UTC; 0 — только заявки.
BRIEF_DEMO_DAILY_CAP=30
BRIEF_BOOKING_URL=/contact
BRIEF_PRIVACY_URL=
# Общий предел символов инструкции и переписки; сохраняется хвост переписки.
LLM_MAX_INPUT_CHARS=24000
# Дневной бюджет токенов (UTC); 0 — без ограничения. Резервируются вход + максимум выхода.
AI_DAILY_TOKEN_LIMIT=0
AI_WORKSPACE_DAILY_TOKEN_LIMIT=0
# Стоимость 1M входящих/исходящих токенов в рублях; неизвестная цена не считается бесплатной.
AI_PRICES={}
# Распознавание речи для разбора звонков: yandex (SpeechKit; ключ и каталог по умолчанию — LLM_API_KEY/YANDEX_FOLDER_ID) | openai (Whisper)
STT_PROVIDER=
STT_API_KEY=
STT_MODEL=
STT_BASE_URL=
# Для Whisper — verbose_json; для Timeweb transcribe — json.
STT_RESPONSE_FORMAT=verbose_json
YANDEX_FOLDER_ID=
# Push-уведомления в браузер/телефон (PWA). Пусто — ключи создадутся при первом запуске
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
