# Copy to .env.prod on the server; never commit the filled file.
# SITE_DOMAIN must already resolve to this server before starting Caddy.
SITE_DOMAIN=steptolead.ru

# Generate each value separately with: openssl rand -hex 32
# Hex avoids URL-escaping problems in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-64-hex-characters
ENCRYPTION_SECRET=replace-with-another-64-hex-characters

# Only needed if the Telegram account features are used.
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=

# Bot for lead/sale notifications (token from @BotFather). Leave empty to disable.
TELEGRAM_BOT_TOKEN=
